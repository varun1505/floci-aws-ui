    "@aws-sdk/client-cloudwatch": "^3.1167.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1167.0",
    "@aws-sdk/client-ec2": "^3.1167.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1167.0",
    "@aws-sdk/client-elasticache": "^3.1167.0",
    "@aws-sdk/client-iam": "^3.1167.0",
    "@aws-sdk/client-kms": "^3.1167.0",
    "@aws-sdk/client-lambda": "^3.1167.0",
    "@aws-sdk/client-rds": "^3.1167.0",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-ses": "^3.1167.0",
    "@aws-sdk/client-sns": "^3.1167.0",
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@aws-sdk/client-ssm": "^3.1167.0",
