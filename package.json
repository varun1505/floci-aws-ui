    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ace-builds": "^1.45.2",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
