{
  "name": "floci-aws-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "A web console for floci, the local AWS emulator. Looks and works like the AWS console.",
  "keywords": [
    "floci",
    "aws",
    "emulator",
    "console",
    "cloudscape",
    "local-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varun1505/floci-aws-ui.git"
  },
  "homepage": "https://github.com/varun1505/floci-aws-ui#readme",
  "bugs": "https://github.com/varun1505/floci-aws-ui/issues",
  "bin": {
    "floci-aws-ui": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node server.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
