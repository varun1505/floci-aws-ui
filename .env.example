# Where the floci AWS emulator listens. Copy this file to .env.local and edit.
FLOCI_ENDPOINT=http://localhost:4566
# Optional. Accounts for the account menu: 12-digit IDs with optional names.
# FLOCI_ACCOUNTS=111111111111=storefront,222222222222=payments-api
# Uncomment to turn on the EC2 browser terminal. It needs the Docker daemon that floci uses.
# EC2_TERMINAL=1
# DOCKER_HOST=unix:///var/run/docker.sock
